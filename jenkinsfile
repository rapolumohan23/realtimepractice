pipeline {
    agent any

    environment {
        IMAGE_NAME = "my-app"
        IMAGE_TAG  = "latest"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${IMAGE_NAME}:${IMAGE_TAG}")
                }
            }
        }
    }

    post {
        success {
            echo "Docker image built successfully 🎉"
        }
        failure {
            echo "Build failed ❌"
        }
    }
}
