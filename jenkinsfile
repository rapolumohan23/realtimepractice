pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                echo "Cloning GitHub repository..."
                checkout scm
            }
        }

        stage('Verify Workspace') {
            steps {
                echo "Listing files in workspace"
                sh 'ls -l'
            }
        }

        stage('Test Step') {
            steps {
                echo "Pipeline is working successfully!"
            }
        }
    }

    post {
        success {
            echo "✅ Jenkins pipeline executed successfully"
        }
        failure {
            echo "❌ Jenkins pipeline failed"
        }
    }
}
