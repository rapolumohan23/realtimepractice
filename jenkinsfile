pipeline {
    agent any

    stages {

        stage('Git Clone') {
            steps {
                git branch: 'dev',
                    url: 'https://github.com/rapolumohan23/realtimepractice.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t my-app:latest .'
            }
        }

    }
}
