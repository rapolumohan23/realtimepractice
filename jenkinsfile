pipeline {
    agent any

   

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t hello-node-app:latest .'
            }
        }
    
    }

    post {
        success {
            echo "Docker image built successfully 🎉"
        }
        failure {
            echo "Build failed ❌"
        }
    }
}
