pipeline {
    agent any
    


    environment {
        IMAGE_NAME = "node-app1"
        TAG = "latest"
    }

    stages {

        stage('Git Clone') {
            steps {
                git branch: 'dev',
                    url: 'https://github.com/rapolumohan23/realtimepractice.git'
            }
        }

        stage('Build') {
            steps {
                sh 'npm install'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${TAG} .'
            }
        }

        stage('Run Container') {
            steps {
                sh 'docker run -d -p 4000:4000 --name node-container ${IMAGE_NAME}:${TAG}'
            }
        }

    }
}
